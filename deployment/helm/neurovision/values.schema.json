{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "api", "worker", "web", "ingress", "autoscaling"],
  "properties": {
    "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "api": {"$ref": "#/definitions/component"},
    "worker": {"$ref": "#/definitions/component"},
    "web": {"$ref": "#/definitions/component"},
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "cpuUtilization": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["image", "replicas", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "replicas": {"type": "integer", "minimum": 1},
        "gpu": {"type": "boolean"},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    }
  }
}
